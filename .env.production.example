# Runtime
NODE_ENV=production
PORT=3000
API_PREFIX=api
LOG_LEVEL=info

# Set this to the exact frontend origins that should call the API.
# Example: https://app.example.com,capacitor://localhost,ionic://localhost
CORS_ORIGINS=

# DigitalOcean managed Postgres.
# Prefer a separate database, e.g. vector_app_db, on the existing cluster.
# Keep connection_limit low while sharing a small DB cluster with Pathshalax.
# Example:
# DATABASE_URL=postgresql://vector_app_user:REPLACE_ME@db-host.db.ondigitalocean.com:25060/vector_app_db?schema=public&sslmode=require&connection_limit=3
DATABASE_URL=

# Backend authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d

# Google OAuth
# Use either GOOGLE_CLIENT_ID or GOOGLE_CLIENT_IDS.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep literal \n sequences in this quoted service-account private key.
FIREBASE_PRIVATE_KEY=
EMAIL_FROM=
EMAIL_API_KEY=
SENTRY_DSN=

# Application limits and data windows
OFFLINE_BOOTSTRAP_PAST_DAYS=90
OFFLINE_BOOTSTRAP_FUTURE_DAYS=30
DEFAULT_HISTORY_BEFORE_DAYS=7
DEFAULT_HISTORY_AFTER_DAYS=7
DEFAULT_GRAPH_DAILY_DAYS=30
DEFAULT_GRAPH_WEEKLY_WEEKS=12
DEFAULT_GRAPH_MONTHLY_MONTHS=12
MAX_SYNC_ACTIONS_PER_PUSH=100
MAX_NOTIFICATIONS_PER_DAY=3
